{
  "name": "writer",
  "displayName": "Caret",
  "description": "Notion-style rich text editor for Markdown and RTF files.",
  "version": "1.0.0",
  "publisher": "vscode",
  "license": "MIT",
  "engines": {
    "vscode": "^1.104.0"
  },
  "enabledApiProposals": [
    "chatContextProvider"
  ],
  "main": "./out/extension",
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "activationEvents": [
    "onCustomEditor:vscode.writer.editor",
    "onChatContextProvider:vscode.writer-writerDocument",
    "onLanguageModelTool:writer_addCaretComment",
    "onView:writer.commentsPanel",
    "onView:writer.commentsPanel.right"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "writer-sidebar",
          "title": "Comments",
          "icon": "$(comment-discussion)"
        }
      ],
      "secondarySidebar": [
        {
          "id": "writer-secondary",
          "title": "Comments",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "writer-sidebar": [
        {
          "id": "writer.commentsPanel",
          "name": "Comments",
          "type": "webview"
        }
      ],
      "writer-secondary": [
        {
          "id": "writer.commentsPanel.right",
          "name": "Comments",
          "type": "webview"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "vscode.writer.editor",
        "displayName": "Caret",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.rtf"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "vscode.writer.openChatWithSelection",
        "title": "Open Chat with Writer Selection",
        "category": "Writer"
      },
      {
        "command": "vscode.writer.showComments",
        "title": "Show Comments (Primary Side Bar)",
        "category": "Writer"
      },
      {
        "command": "vscode.writer.showCommentsAuxiliary",
        "title": "Show Comments (Secondary Side Bar)",
        "category": "Writer"
      },
      {
        "command": "vscode.writer.addComment",
        "title": "Add Caret Comment (agent)",
        "category": "Writer"
      },
      {
        "command": "vscode.writer.insertFootnote",
        "title": "Insert Footnote (agent)",
        "category": "Writer"
      }
    ],
    "languageModelTools": [
      {
        "name": "writer_addCaretComment",
        "displayName": "Add Caret comment",
        "toolReferenceName": "caretComment",
        "canBeReferencedInPrompt": true,
        "icon": "$(comment-discussion)",
        "tags": [
          "writer",
          "caret",
          "comments",
          "review"
        ],
        "modelDescription": "Adds a Writer/Caret review comment anchored to the user's current text selection in the Caret editor. Comments are stored in the Writer Comments side bar (not inline in the Markdown file). Requires the document to be open in the Caret custom editor (not the built-in text editor) and a non-empty selection when invoked. Use when the user wants feedback, review notes, or discussion attached to a specific passage.",
        "userDescription": "Add a Caret review comment on the selected text (Writer Comments panel).",
        "inputSchema": {
          "type": "object",
          "properties": {
            "body": {
              "type": "string",
              "description": "The full text of the review comment to attach to the current selection."
            }
          },
          "required": [
            "body"
          ]
        }
      }
    ]
  },
  "scripts": {
    "compile": "npm run build-webview && node ../../node_modules/gulp/bin/gulp.js --gulpfile ../../build/gulpfile.extensions.ts compile-extension:writer",
    "watch": "npm run build-webview && node ../../node_modules/gulp/bin/gulp.js --gulpfile ../../build/gulpfile.extensions.ts watch-extension:writer",
    "build-webview": "node ./esbuild.webview.mts",
    "watch-webview": "node ./esbuild.webview.mts --watch"
  },
  "devDependencies": {
    "@tiptap/extension-bubble-menu": "^2.27.2",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/extension-task-item": "^2.11.5",
    "@tiptap/extension-task-list": "^2.11.5",
    "@tiptap/extension-text-align": "^2.27.2",
    "@tiptap/extension-underline": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "@types/node": "22.x",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/turndown": "^5.0.5",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
